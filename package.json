{
  "name": "navbharatai-pro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "predev": "node scripts/copyMonaco.mjs",
    "copy:monaco": "node scripts/copyMonaco.mjs",
    "prebuild": "node scripts/copyMonaco.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gcloud:build": "gcloud builds submit --config=cloudbuild.yaml .",
    "gcloud:deploy": "gcloud run deploy navbharat-cloud-run --image=gcr.io/gcp-navbharat-core/navbharat-cloud-run:latest --platform=managed --region=asia-southeast1 --port=8080 --set-env-vars=NODE_ENV=production --allow-unauthenticated",
    "boot:check": "bash scripts/boot-check.sh",
    "test:bundle": "node scripts/bundleBudget.mjs",
    "test:load": "node scripts/loadTest.mjs",
    "audit:gate": "node scripts/auditGate.mjs",
    "license:gate": "node scripts/licenseGate.mjs",
    "sbom": "node scripts/genSbom.mjs",
    "bakeoff": "tsx scripts/agentv3-bakeoff.ts",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:ios": "npm run build && npx cap add ios && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws-sdk/client-bedrock-runtime": "^3.1104.0",
    "@babel/standalone": "^7.26.4",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.2.0",
    "@google/generative-ai": "^0.24.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@zip.js/zip.js": "^2.8.34",
    "axios": "^1.18.1",
    "cashfree-pg": "^6.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dockerode": "^5.0.0",
    "dotenv": "^17.2.3",
    "e2b": "^2.30.0",
    "es-module-lexer": "^2.3.1",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
