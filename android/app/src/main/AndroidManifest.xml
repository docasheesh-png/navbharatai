<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BACKUP IS DELIBERATE NOW, NOT ACCIDENTAL (2026-08-28). `allowBackup="true"` with no rules
         meant Android backed up the whole data directory — including the WebView caches. The per-app
         cloud limit is 25 MB and past it Android backs up NOTHING, silently, so a ~39 MB asset bundle
         plus a service-worker cache could mean backup was failing outright and users were quietly
         signing in again on every new phone.

         Both attributes are required: minSdkVersion is 24, and each is ignored by the API levels the
         other covers. `fullBackupContent` serves API 24-30, `dataExtractionRules` serves API 31+.
         The rules exclude WebView CACHES ONLY — never `Local Storage` or `IndexedDB`, which hold the
         Firebase Auth session. See the comments in both files for the line not to cross. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for the GitHub OAuth return. The server callback redirects the token to
                 com.navbharat.ai://github-callback#gh_token=..., which the OS routes back to this
                 (singleTask) activity and Capacitor's App plugin surfaces as `appUrlOpen`. This is what
                 brings the user back INTO the app after signing in, instead of stranding them in a
                 browser on the website. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.navbharat.ai" />
            </intent-filter>

            <!-- ANDROID APP LINKS (admin 2026-09-19: "mujhe sabse acchi native app banani hai").
                 Tapping a navbharatai.com link opened a BROWSER, which is both the loudest "this is a
                 website" moment left and a growth leak — share links, referral codes, published apps.

                 `autoVerify` asks Android to fetch https://navbharatai.com/.well-known/assetlinks.json
                 and confirm this package is named there beside our signing certificate's SHA-256. That
                 file is served by server.ts from ANDROID_CERT_SHA256 (see src/server/lib/assetLinks.ts).
                 UNTIL THAT VALUE IS SET verification fails and Android hands these URLs back to the
                 browser — i.e. exactly today's behaviour, which is what makes this safe to ship first.

                 🔒 THE PATHS ARE AN ALLOWLIST, NOT `pathPrefix="/"`. Claiming a URL the app cannot serve
                 is WORSE than not claiming it: the app opens, dumps the user on Home, and has eaten the
                 page they asked for. So this list is exactly src/lib/deepLinkRoute.ts's APP_LINK_CLAIMS,
                 and tests/aLinkOpensTheApp.test.ts fails CI if the two ever disagree.

                 NOT claimed, deliberately: /privacy and /terms. Play and Meta fetch those with tools
                 that may not run JavaScript, and a person tapping a privacy link asked for that page —
                 not for our home screen. They stay with the browser.

                 An intent filter matches the PATH only; a query string cannot be matched. That is why
                 /?view=appstore — the older share link, still in circulation — rides the "/" claim and
                 is resolved in JavaScript by deepLinkTarget. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="navbharatai.com" />
                <data android:scheme="https" android:host="www.navbharatai.com" />
                <data android:path="/" />
                <data android:path="/admin" />
                <data android:path="/store" />
                <data android:pathPrefix="/store/app/" />
            </intent-filter>

        </activity>

        <!-- META (Facebook / Instagram) APP EVENTS — the values are supplied by build.gradle from the
             CI environment (repo secrets), never hard-coded here.

             INERT UNLESS CONFIGURED: with no FACEBOOK_APP_ID / FACEBOOK_CLIENT_TOKEN set, both string
             resources are empty and the SDK is not even a dependency — so these five entries are
             strings nothing reads. That is what lets this ship ahead of the credentials without
             altering the app at all.

             AutoLogAppEvents is what actually reports an install and an app-open to Meta, which is
             the entire point: it is what makes an "App Install" campaign possible instead of a
             clicks-only Traffic campaign. AdvertiserIDCollection is what lets Meta match that install
             back to the ad that caused it — it rides the same flag deliberately, so there is one
             switch, and no state where events are collected but attribution silently is not. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token" />
        <!-- ALL THREE SHIP OFF, DELIBERATELY — see MetaConsentPlugin.java.
             The SDK initialises itself from a ContentProvider at process start, so left at "true" it
             would log app events and read the advertising ID before the consent banner had even been
             drawn. The banner names Meta and promises this happens only if the user accepts, and the
             Play Data safety declaration says "users can choose" — both are only true if the switches
             start closed. MetaConsentPlugin opens them the moment consent is granted, and closes them
             again if it is withdrawn. Do NOT put a build-time placeholder back in these three values:
             that would re-arm collection before consent, with nothing failing to reveal it. -->
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" />
        <meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="false" />

        <!--
          PUSH NOTIFICATIONS — WHAT ONE LOOKS LIKE (2026-09-20, admin: "ek dam native app jaise
          notification mobile me dikhe").

          The SEND side has existed since 2026-08-25 (PushNotificationService.ts) and the receive side
          since the same day (@capacitor-firebase/messaging, src/lib/pushNotifications.ts). What was
          never set is how the notification PRESENTS, and all three of these default badly:

            • default_notification_icon — unset, so Firebase falls back to android:icon. That is an
              adaptive launcher icon, and Android renders a full-colour icon in the status bar as a
              featureless WHITE SQUARE. A notification-specific icon must be a silhouette defined by
              its ALPHA; @drawable/ic_stat_nbai is exactly that, derived from the app's own
              ic_launcher_monochrome mark (see scripts/notificationIcon.mjs) rather than drawn anew.
            • default_notification_color — unset, so the system greys the icon and the app-name line.
            • default_notification_channel_id — unset, so every message lands in Android's fallback
              "Miscellaneous" channel. That channel is what the user sees in Settings -> Notifications,
              and "Miscellaneous" is the single clearest tell that an app did not set this up.

          The channel named here is CREATED by the app at startup (src/lib/pushNotifications.ts). Naming
          a channel that does not exist is not an error and not a fix either — Android silently falls
          back to Miscellaneous again, so the two must be changed together. Pinned in both directions
          by tests/aNotificationLooksLikeOurApp.test.ts.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_nbai" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/nbaiNotificationAccent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nbai_updates" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Package visibility (Android 11+, API 30+): declare that we launch the Play Store via a
         `market://` intent, so the "Update" button opens the store APP rather than the website in a
         browser (admin report 2026-08-16). Without this <queries> entry a market:// intent cannot be
         resolved on API 30+ and the launch silently fails. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone: NavBharatAI Voice (getUserMedia in the WebView). Capacitor's BridgeWebChromeClient
         auto-requests the runtime prompt when the WebView asks for audio, but ONLY if declared here —
         without these the mic request was auto-denied ("Permission denied" on the voice screen). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera: image capture / scanning inside the app. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Location: features that use the browser Geolocation API. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Storage: file uploads/downloads. Scoped by SDK — legacy read/write only up to Android 12 (API 32);
         Android 13+ uses the granular media reads. WRITE is legacy-only (maxSdk 28). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Advertising ID — REQUIRED to declare explicitly once an app targets Android 13 (API 33) and
         has an advertising-ID collector in the build (Meta's SDK, added when FACEBOOK_APP_ID/
         FACEBOOK_CLIENT_TOKEN are configured — see build.gradle). Before API 33 this permission was
         implicitly granted to any app whose manifest merged an ad SDK; from API 33 it must be
         declared here or the platform ZEROES OUT the advertising ID for every app on the device,
         silently breaking the Data safety declaration this project already filed ("Device or other
         IDs" collected, shared, for Advertising/Analytics — see the Play Data safety form and
         MetaConsentPlugin.java). This permission alone does not collect anything — it only lets the
         OS return a real value to whatever asks; MetaConsentPlugin still gates the ACTUAL read
         behind the user's consent choice at runtime, exactly as before. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Features are optional so the app installs on devices lacking a camera/mic. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- NOTE: READ_SMS / RECEIVE_SMS are DELIBERATELY NOT declared. OTP auto-read uses the Google SMS
         Retriever API (built into Firebase native phone auth) which is hash-scoped and needs NO SMS
         permission — and Play Store REJECTS apps that request SMS permissions unless they are the
         device's default SMS handler. Auto-verification still works without them. -->
</manifest>
