node_modules/
# ...and a node_modules that is a SYMLINK, which the trailing slash above does NOT match.
# A `git add -A` beside one therefore COMMITS it, and a checkout then replaces the real
# directory with a link to an absolute path that exists on no other machine — which is exactly
# how a working tree lost its dependencies on 2026-09-18. Both forms, so neither can be added.
node_modules
dist/
build/
.next/
out/
coverage/
.venv/
__pycache__/
.cache/
.e-checkpoints/
.DS_Store
*.log

# Generated runtime/test artifacts (not source) — written to CWD by tests/tools at runtime
project_memory.json
test_environment_debug.json
public/monaco/
.emitted-test-modules/
