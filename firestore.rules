rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    // --- Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username']) &&
             data.keys().size() <= 10 &&
             data.uid == request.auth.uid &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 32;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['userId', 'type', 'content', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.userId == request.auth.uid &&
             data.type in ['text', 'image', 'reel'] &&
             data.content is string && data.content.size() <= 2000 &&
             data.timestamp is string;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'timestamp', 'status']) &&
             data.keys().size() == 6 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.status in ['open', 'investigating', 'resolved'];
    }

    // --- Default: deny everything not explicitly allowed ---
    match /{document=**} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      // P-SEC.1: `role` is server-managed (admin SDK only) — clients may never set or
      // change it, else a user could self-escalate to owner/admin. (isValidUser allows
      // up to 10 arbitrary keys, so this explicit guard is required.)
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
                       !('role' in incoming());
      allow update: if isVerified() && isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       (!('role' in incoming())
                          ? !('role' in existing())
                          : ('role' in existing() && incoming().role == existing().role));
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(postId) && isValidPost(incoming());
      allow update: if isVerified() && isValidId(postId) && existing().userId == request.auth.uid &&
                       isValidPost(incoming()) && incoming().userId == existing().userId;
      allow delete: if isVerified() && isValidId(postId) && existing().userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isVerified() && isValidId(commentId) && incoming().userId == request.auth.uid;
        allow delete: if isVerified() && isValidId(commentId) && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(groupId) && incoming().adminId == request.auth.uid;
      allow update: if isVerified() && isValidId(groupId) && existing().adminId == request.auth.uid &&
                       incoming().adminId == existing().adminId;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isVerified() && isValidId(messageId) && incoming().userId == request.auth.uid;
      }
    }

    // Reports
    match /reports/{reportId} {
      allow read: if isVerified() && isValidId(reportId) && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(reportId) && isValidReport(incoming());
    }

    // Build jobs — signed-in owner only
    match /build_jobs/{jobId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Wallet — owner only, no delete from client
    match /user_token_wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // server-only writes
    }

    // Cloud-synced workspace (chat sessions + last app) — owner read, server writes
    match /user_workspaces/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // server-only writes via /api/sync
    }

    // AI usage logs — server writes only, user can read own logs
    match /ai_usage_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // Payment transactions — read own, no client writes
    match /payment_transactions/{txId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // server-only
    }

    // Promo redemptions — user can create own, no update/delete
    match /promo_redemptions/{redemptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // User secrets — owner only, strict
    match /user_secrets/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Chat sessions — owner only
    match /chat_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Chat messages — owner only
    match /chat_messages/{messageId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Chat agent history — owner only
    match /chat_agent_history/{transitionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Live Collaboration rooms (src/components/ide/LiveCollaboration.tsx).
    // Access model (admin-decided 2026-07-28): SIGNED-IN users only; the 6-char Room ID is the
    // shared access token — any signed-in user who has the ID may join, read, and edit the room
    // (shareable-link collaboration). Listing the whole collection is blocked so rooms can't be
    // enumerated; you can only `get` a room by its exact ID. Sizes are capped so a room document
    // (and its messages) stay well under Firestore's 1 MB per-document limit.
    function isValidRoomCode(data) {
      return !('code' in data) || (data.code is string && data.code.size() <= 700000);
    }
    match /collab_rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if false; // no enumerating all rooms — a room is reachable only by its exact ID
      // The creator must stamp themselves as owner (createdBy == their uid).
      allow create: if isSignedIn() && isValidId(roomId)
                       && incoming().createdBy == request.auth.uid
                       && isValidRoomCode(incoming());
      // Any signed-in member may update the shared room, but the owner stamp is immutable and the
      // shared code stays size-bounded.
      allow update: if isSignedIn()
                       && isValidRoomCode(incoming())
                       && incoming().createdBy == existing().createdBy;
      allow delete: if false; // rooms are cleaned up server-side (TTL), never client-deleted

      // Live cursors — you may only write your OWN presence doc (id must match your uid).
      match /presence/{memberId} {
        allow read: if isSignedIn();
        allow write: if isOwner(memberId);
      }
      // Team chat — members read all; you may only author your own messages; immutable after.
      match /chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                         && incoming().authorId == request.auth.uid
                         && incoming().text is string && incoming().text.size() <= 2000;
        allow update, delete: if false;
      }
      // Line-anchored comments — you may only author your own; any member may resolve (merge update).
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                         && incoming().authorId == request.auth.uid
                         && incoming().text is string && incoming().text.size() <= 1000;
        allow update: if isSignedIn();
        allow delete: if false;
      }
      // Shared in-room AI thread (Phase 1a) — every member sees the same AI conversation. The member
      // who triggers a turn writes BOTH the user prompt and the AI reply (authorId == their uid), and
      // the AI call is billed to that member's own account (client-relayed). Immutable once written.
      match /ai_chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                         && incoming().authorId == request.auth.uid
                         && incoming().text is string && incoming().text.size() <= 20000;
        allow update, delete: if false;
      }
    }
  }
}
