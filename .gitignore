# No trailing slash, on purpose: `node_modules/` matches a DIRECTORY only, so a node_modules that
# is a SYMLINK was not ignored, `git add -A` beside one COMMITTED it, and a checkout then replaced
# the real directory with a link to an absolute path that exists on no other machine — which is
# exactly how a working tree lost its dependencies on 2026-09-18. The bare name matches a
# directory, a file and a symlink alike. Locked by tests/nodeModulesIsNotAFile.test.ts.
node_modules
dist/
build/
.next/
out/
coverage/
.venv/
__pycache__/
.cache/
.e-checkpoints/
.DS_Store
*.log

# Generated runtime/test artifacts (not source) — written to CWD by tests/tools at runtime
project_memory.json
test_environment_debug.json
public/monaco/
.emitted-test-modules/
scripts/ideShortcutAudit/dist/

# Scratch projects the strict-trial and image-app tests build inside tests/ (they need the repo node_modules).
# A run stopped mid-test leaves one behind; it must never be committed (it was, once, in #3490).
tests/.tmp-*/

# Live environment files hold real credentials — never committed. Only the committed template
# (.env.example, placeholders only) is tracked. Security checklist 2026-10-04; locked by
# tests/thePlatformKeepsItsSecretsOutOfGit.test.ts.
.env
.env.*
!.env.example

# Executable 3D-layer tests write the generated modules here and delete them afterwards.
tests/.tmp-game3d-*/
tests/.tmp-game-meta-*/

# build-reliability benchmark output (scripts/agentv3-reliability-bench.ts)
scripts/bench-results/
