<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for the GitHub OAuth return. The server callback redirects the token to
                 com.navbharat.ai://github-callback#gh_token=..., which the OS routes back to this
                 (singleTask) activity and Capacitor's App plugin surfaces as `appUrlOpen`. This is what
                 brings the user back INTO the app after signing in, instead of stranding them in a
                 browser on the website. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.navbharat.ai" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Package visibility (Android 11+, API 30+): declare that we launch the Play Store via a
         `market://` intent, so the "Update" button opens the store APP rather than the website in a
         browser (admin report 2026-08-16). Without this <queries> entry a market:// intent cannot be
         resolved on API 30+ and the launch silently fails. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone: NavBharatAI Voice (getUserMedia in the WebView). Capacitor's BridgeWebChromeClient
         auto-requests the runtime prompt when the WebView asks for audio, but ONLY if declared here —
         without these the mic request was auto-denied ("Permission denied" on the voice screen). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera: image capture / scanning inside the app. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Location: features that use the browser Geolocation API. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Storage: file uploads/downloads. Scoped by SDK — legacy read/write only up to Android 12 (API 32);
         Android 13+ uses the granular media reads. WRITE is legacy-only (maxSdk 28). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Features are optional so the app installs on devices lacking a camera/mic. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- NOTE: READ_SMS / RECEIVE_SMS are DELIBERATELY NOT declared. OTP auto-read uses the Google SMS
         Retriever API (built into Firebase native phone auth) which is hash-scoped and needs NO SMS
         permission — and Play Store REJECTS apps that request SMS permissions unless they are the
         device's default SMS handler. Auto-verification still works without them. -->
</manifest>
