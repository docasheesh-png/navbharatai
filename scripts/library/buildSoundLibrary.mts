/**
 * Maintainer-only sound library builder (2026-11-19). Reads a LOCAL clone of facebookincubator/Meta-open-sound,
 * refuses any clone not at the pinned revision or with local changes, checks the pack licence and its index,
 * hashes every chosen OGG, DECODES it in Chromium (duration, peak, audible RMS), computes a loudness gain toward
 * the target for its kind (gains only ever reduce, so nothing can clip), and writes:
 *   - src/server/AgentV3/gameAssets/soundLibraryCatalogue.ts
 *   - docs/game-engine/asset-candidates/sound-library-2026-11-19.json (measurements)
 * Usage: node --import tsx scripts/library/buildSoundLibrary.mts <Meta-open-sound clone> <playwright index.mjs>
 */
import assert from 'node:assert/strict';
import { readFile, writeFile } from 'node:fs/promises';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { SOUND_PICKS } from './soundPicks.mts';

const REVISION = '514c926efecdb3c7812bf00eedf8e5c8d61dd681';
const PACK = 'corpora/oculus-audio-pack';
const [cloneArg, playwrightArg] = process.argv.slice(2);
assert.ok(cloneArg && playwrightArg, 'Supply the clone and the Playwright module path');
const clone = resolve(cloneArg);
assert.equal(execFileSync('git', ['-C', clone, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(), REVISION, 'clone is not at the pinned revision');
assert.equal(execFileSync('git', ['-C', clone, 'status', '--porcelain'], { encoding: 'utf8' }).trim(), '', 'clone has local changes');
const licence = await readFile(join(clone, PACK, 'LICENSE'), 'utf8');
assert.match(licence, /^Attribution 4\.0 International/);
const sha = (b: Uint8Array) => createHash('sha256').update(b).digest('hex');
const attribution = JSON.parse(await readFile(join(clone, PACK, 'index', 'UI.json'), 'utf8')).attribution as string;
assert.match(attribution, /Oculus Audio Pack 01.*CC BY 4\.0/);

const { chromium } = await import(pathToFileURL(resolve(playwrightArg)).href) as typeof import('playwright');
const browser = await chromium.launch(); const page = await browser.newPage(); await page.setContent('<html></html>');
const target = (name: string, loop: boolean, bus: string) => name.startsWith('step') || name === 'land' ? -24 : bus === 'music' ? -30 : loop ? -24 : -18;
const entries: unknown[] = []; const evidence: unknown[] = [];
const names = new Set<string>();
for (const [name, id, loop, bus, core, words] of SOUND_PICKS) {
  assert.ok(/^[a-z][a-z_]{1,31}$/.test(name) && !names.has(name), `bad or duplicate name ${name}`); names.add(name);
  const path = `${PACK}/ogg/${id}.ogg`;
  const bytes = await readFile(join(clone, path));
  assert.equal(bytes.subarray(0, 4).toString('latin1'), 'OggS', `${name}: not an Ogg stream`);
  const m = await page.evaluate(async (b64: string) => {
    const raw = Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
    const buf = await new OfflineAudioContext(2, 48000, 48000).decodeAudioData(raw);
    let peak = 0;
    for (let c = 0; c < buf.numberOfChannels; c++) for (const v of buf.getChannelData(c)) peak = Math.max(peak, Math.abs(v));
    const d = buf.getChannelData(0), w = Math.floor(buf.sampleRate * 0.05); let s = 0, n = 0;
    for (let i = 0; i + w <= d.length; i += w) { let e = 0; for (let j = i; j < i + w; j++) e += d[j] * d[j]; e /= w; if (e > 1e-5) { s += e; n++; } }
    return { duration: buf.duration, peak, rmsDb: 10 * Math.log10((n ? s / n : 1e-12) + 1e-12) };
  }, bytes.toString('base64'));
  assert.ok(m.duration > 0.05 && m.peak > 0.05, `${name}: decoded silent or empty`);
  const gain = Math.round(Math.min(1, Math.max(0.05, 10 ** ((target(name, loop, bus) - m.rmsDb) / 20))) * 1000) / 1000;
  entries.push({ name, id, file: `${id}.ogg`, url: `https://raw.githubusercontent.com/facebookincubator/Meta-open-sound/${REVISION}/${path}`,
    sha256: sha(bytes), bytes: bytes.byteLength, loop, bus, core, words, gain, duration: Math.round(m.duration * 100) / 100 });
  evidence.push({ name, id, ...m, gain });
  console.log(name, bytes.byteLength, m.duration.toFixed(2), m.rmsDb.toFixed(1), gain);
}
await browser.close();
await writeFile('src/server/AgentV3/gameAssets/soundLibraryCatalogue.ts', `/** Generated by scripts/library/buildSoundLibrary.mts from pinned Meta-open-sound ${REVISION}; do not hand-edit. */
export const SOUND_LIBRARY_REVISION = '${REVISION}';
export const SOUND_LIBRARY_LICENCE = { spdx: 'CC-BY-4.0' as const, attribution: ${JSON.stringify(attribution)}, evidenceUrl: 'https://github.com/facebookincubator/Meta-open-sound/blob/${REVISION}/${PACK}/LICENSE' };
export interface LibrarySound { name: string; id: string; file: string; url: string; sha256: string; bytes: number; loop: boolean; bus: 'sfx' | 'music' | 'ui'; core: boolean; words: readonly string[]; gain: number; duration: number }
export const SOUND_LIBRARY: readonly LibrarySound[] = ${JSON.stringify(entries, null, 1)};
`);
await writeFile('docs/game-engine/asset-candidates/sound-library-2026-11-19.json', JSON.stringify(evidence, null, 1) + '\n');
console.log(`${entries.length} sounds`);
