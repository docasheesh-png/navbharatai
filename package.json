    "@tailwindcss/vite": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.18.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "axios": "$axios",
    "undici": "^7.28.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "tar": "^7.5.22"
  }
}
