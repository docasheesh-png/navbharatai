# Gemini API Key (Primary AI — fastest)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Final fallback — highest quality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Grok / xAI API Key (3rd fallback — get from console.x.ai)
GROK_API_KEY=your_grok_xai_api_key_here

# Encryption Key for Secrets
SECRET_ENCRYPTION_KEY=your_secret_encryption_key_here

# GitHub Integration (Professional Developer Features)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=https://your-domain.run.app/api/auth/github/callback

# Cashfree Payment Gateway
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# ─── Firebase (Frontend — Vite build-time) ───────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_FIRESTORE_DB=your_firestore_database_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER=your_sender_id

# Free-tier paid leak guard (lib/freeTierPaidCap.ts): ONE daily USD cap (IST day, max 10) shared with
# FreeChain's budget, covering legacy Free chat, Free professionals fallback, Doctor AI free and Free vision.
FREE_TIER_PAID_DAILY_CAP_USD=10

# ── Free Chat tiered provider chain (docs/FREE_CHAT_TIERS.md). Names only; keys live in Secret Manager. ──
# FREE_CHAIN_ENABLED=off
# FREE_CHAIN_ROLLOUT_PERCENT=0
# FREE_CHAIN_ALLOW_UIDS=
# FREE_CHAIN_MAX_ATTEMPTS=4
# FREE_CHAIN_STICKY_SPREAD=off
# FREE_CHAIN_PAID_DAILY_CAP_USD=10
# Tier 1: FREE_CHAIN_GLM_API_KEY= FREE_CHAIN_GROQ_API_KEY= FREE_CHAIN_CF_API_TOKEN= CLOUDFLARE_ACCOUNT_ID= FREE_CHAIN_GEMINI_API_KEY=
# Tier 2: OPENROUTER_API_KEY= FREE_CHAIN_OPENROUTER_MODELS=
# Tier 3 (paid): FREE_CHAIN_GLMX_API_KEY= FREE_CHAIN_DEEPINFRA_API_KEY= FREE_CHAIN_OPENAI_API_KEY= FREE_CHAIN_DEEPSEEK_API_KEY=
# Terms-blocked (need FREE_CHAIN_<P>_WRITTEN_APPROVAL=on): FREE_CHAIN_NVIDIA_API_KEY= FREE_CHAIN_MODELSCOPE_API_KEY= FREE_CHAIN_LLM7_API_KEY= FREE_CHAIN_BLUESMINDS_API_KEY= FREE_CHAIN_REQUESTY_API_KEY=
