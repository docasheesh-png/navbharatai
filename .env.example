# Gemini API Key (Primary AI — fastest)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Final fallback — highest quality)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Grok / xAI API Key (3rd fallback — get from console.x.ai)
GROK_API_KEY=your_grok_xai_api_key_here

# Encryption Key for Secrets
SECRET_ENCRYPTION_KEY=your_secret_encryption_key_here

# GitHub Integration (Professional Developer Features)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=https://your-domain.run.app/api/auth/github/callback

# Cashfree Payment Gateway
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# ─── Firebase (Frontend — Vite build-time) ───────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_FIRESTORE_DB=your_firestore_database_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER=your_sender_id

# ── Unified credit wallet (docs/UNIFIED_WALLET.md) — default OFF ─────────────
# 1 credit = ₹1. NavBharatAI Chat past the daily allowance and Pro builds debit the SAME wallet.
UNIFIED_WALLET_ENABLED=1                   # paid NavBharatAI Chat past the free quota
UNIFIED_WALLET_FREE_LIMIT=0                # signed-in free quota 20 → 25/day
UNIFIED_WALLET_CHARGED_SURFACES=chat,professionals,exam,repo-analyst   # default: every Free surface
UNIFIED_WALLET_CHAT_MESSAGE_MILLI=100      # milli-credits per Free chat message (100 = ₹0.10, ₹1 = 10 msgs)
UNIFIED_WALLET_GUEST_DAILY=5
UNIFIED_WALLET_SIGNED_IN_DAILY=25
UNIFIED_WALLET_MARGIN=off                  # on = real cost × 2.5 every metered service; or a number 1.01–10
# UNIFIED_WALLET_MARGIN_BUILD=2.5          # optional per-service override (AI, BUILD, HOSTING, …)
UNIFIED_WALLET_PER_MINUTE=20
UNIFIED_WALLET_GUEST_PER_MINUTE=6
UNIFIED_WALLET_LOW_BALANCE_CREDITS=5
UNIFIED_WALLET_GST_PERCENT=18
UNIFIED_WALLET_RECHARGE_PACKS=20,50,100,500   # suggested packs only, GST-inclusive; existing ₹1 minimum unchanged
UNIFIED_WALLET_IMAGE_COUNTS_TEXT=0             # each delivered free image also uses one daily text message
# Free-tier paid leak guard (lib/freeTierPaidCap.ts): ONE daily USD cap (IST day, max 10) shared with
# FreeChain's budget, covering legacy Free chat, Free professionals fallback, Doctor AI free and Free vision.
FREE_TIER_PAID_DAILY_CAP_USD=10

# ── Free Chat tiered provider chain (docs/FREE_CHAT_TIERS.md). Names only; keys live in Secret Manager. ──
# FREE_CHAIN_ENABLED=on
# FREE_CHAIN_ROLLOUT_PERCENT=100
# FREE_CHAIN_ROUTE_REORDER_ENABLED=off
# FREE_CHAIN_ALLOW_UIDS=
# FREE_CHAIN_MAX_ATTEMPTS=4
# FREE_CHAIN_STICKY_SPREAD=off
# FREE_CHAIN_PAID_DAILY_CAP_USD=10
# Tier 1: FREE_CHAIN_GLM_API_KEY= FREE_CHAIN_GROQ_API_KEY= FREE_CHAIN_CF_API_TOKEN= CLOUDFLARE_ACCOUNT_ID= FREE_CHAIN_GEMINI_API_KEY=
# Tier 2: OPENROUTER_API_KEY= FREE_CHAIN_OPENROUTER_MODELS=
# Tier 3 (paid): FREE_CHAIN_GLMX_API_KEY= FREE_CHAIN_DEEPINFRA_API_KEY= FREE_CHAIN_OPENAI_API_KEY= FREE_CHAIN_DEEPSEEK_API_KEY=
# Terms-blocked (need FREE_CHAIN_<P>_WRITTEN_APPROVAL=on): FREE_CHAIN_NVIDIA_API_KEY= FREE_CHAIN_MODELSCOPE_API_KEY= FREE_CHAIN_LLM7_API_KEY= FREE_CHAIN_BLUESMINDS_API_KEY= FREE_CHAIN_REQUESTY_API_KEY=

# Optional, server-only Surplus helper (not connected to production routing).
# Never prefix this key with VITE_. Replace the placeholder locally; never commit .env.
SURPLUS_API_KEY=replace_with_your_surplus_api_key
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
SURPLUS_MODEL=deepseek-v4.1-flash
# Optional estimated minimum-discount route, NOT a latency guarantee:
# SURPLUS_BASE_URL=https://api.surplusintelligence.ai/min30/v1

# OPTIONAL public metadata observer only. OFF by default; never enables Builder inference.
SURPLUS_REGISTRY_ENABLED=false
# Metadata cadence is fixed at five minutes; legacy interval overrides normalize to 300000.
SURPLUS_REGISTRY_INTERVAL_MS=300000
# Observation-only candidates, not coding quality approvals. Explicit list is bounded to 15.
SURPLUS_REGISTRY_MODELS=deepseek-v4.1-flash,deepseek-v4.1-flash-1017,glm-5.3,glm-5.3-flash,glm-5.2,qwen3.8-flash,qwen3.8-2.4t-a95b,qwen3-coder,qwen3-coder-next,qwen3-coder-30b-a3b-instruct,minimax-m2.5,minimax-m2.1,gpt-5.6-luna,gpt-5.6-sol,claude-sonnet-5
# A supported estimated 90% floor for separately authorized direct helper calls:
# SURPLUS_BASE_URL=https://api.surplusintelligence.ai/min90/v1

# Pro app-builder Surplus integration. OFF until reviewed account/pilot/capability/quality/tariffs exist.
AGENTV3_SURPLUS_BUILDER=false

# Chat burst admission per instance; shared provider quotas/spend limits still apply.
# FREE_CHAIN_MAX_ACTIVE=8
# FREE_CHAIN_MAX_QUEUED=1024
# FREE_CHAIN_MAX_WAIT_MS=5000

# Optional server-only Mitrify transport. Ordinary chat remains direct; isolated test requires cost admission.
AI_BACKEND=
# Legacy alias used only when AI_BACKEND is unset or blank.
AI_PROVIDER=
MITRIFY_BASE_URL=
MITRIFY_API_KEY=
MITRIFY_MODEL=
MITRIFY_CHAT_ACCOUNT_EMAIL=
MITRIFY_BOT_ACCESS=
MITRIFY_MAX_INFLIGHT=
