import { GeminiProvider } from './Models/GeminiProvider';
import { VertexProvider } from './Models/VertexProvider';
import { ModelHealthRegistry } from './HealthRegistry';

export class UniversalAIRouter {
  private registry: ModelHealthRegistry;
  private readonly TIMEOUT_MS = 25000;

  constructor() {
    this.registry = new ModelHealthRegistry();
  }

  private async fetchWithTimeout<T>(
    promise: Promise<T>,
    timeoutMs: number
  ): Promise<T> {
    const timeout = new Promise<never>((_, reject) =>
      setTimeout(
        () => reject(new Error(`Timeout after ${timeoutMs}ms`)),
        timeoutMs
      )
    );

    return Promise.race([promise, timeout]);
  }

  private async runOrchestratedInference(
    message: string,
    isPro: boolean = false
  ): Promise<string> {

    // STEP 1: Vertex AI
    console.log('[AI_ORCHESTRATOR] STEP 1: Attempting Vertex AI chain');

    const vertexModels = [
      'gemini-1.5-flash'
    ];

    for (const modelName of vertexModels) {
      try {
        console.log(`[AI_ORCHESTRATOR] Vertex: Trying ${modelName}`);

        const provider = new VertexProvider(modelName);

        const response = await this.fetchWithTimeout(
          provider.generateContent(message),
          this.TIMEOUT_MS
        );

        if (response?.trim()) {
          console.log(
            `[AI_ORCHESTRATOR] Vertex success: ${modelName}`
          );
          return response;
        }
      } catch (error: any) {
        console.warn(
          `[AI_ORCHESTRATOR] Vertex failed: ${modelName}: ${error?.message}`
        );
      }
    }

    // STEP 2: Gemini API Fallback
    console.log(
      '[AI_ORCHESTRATOR] STEP 2: Falling back to Gemini Chain'
    );

    const geminiModels = [
      'gemini-1.5-flash'
    ];

    for (const modelName of geminiModels) {
      try {
        console.log(`[AI_ORCHESTRATOR] Gemini: Trying ${modelName}`);

        const provider = new GeminiProvider(modelName);

        const response = await this.fetchWithTimeout(
          provider.generateContent(message),
          this.TIMEOUT_MS
        );

        if (response?.trim()) {
          console.log(
            `[AI_ORCHESTRATOR] Gemini success: ${modelName}`
          );
          return response;
        }
      } catch (error: any) {
        console.error(
          `[AI_ORCHESTRATOR] Gemini failed: ${modelName}: ${error?.message}`
        );
      }
    }

    // Emergency fallback
    console.error(
      '[AI_ORCHESTRATOR] All providers failed'
    );

    return 'Request could not be completed right now. AI service temporarily unavailable.';
  }

  async routeNavbharat(message: string): Promise<string> {
    return this.runOrchestratedInference(message, false);
  }

  async routeNavbharatPro(message: string): Promise<string> {
    return this.runOrchestratedInference(message, true);
  }

  async route(message: string): Promise<string> {
    return this.runOrchestratedInference(message, false);
  }

  getHealth() {
    return this.registry.getRegistry();
  }
}
