{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/server/routes/**/*.ts",
    "src/server/lib/**/*.ts",
    "src/server/project/**/*.ts",
    "src/server/runtime/**/*.ts",
    "src/server/AgentV3/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "remote-keyboard"
  ]
}
