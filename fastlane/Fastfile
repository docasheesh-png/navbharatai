# NavBharatAI — iOS App Store build + TestFlight upload (cloud-signed, no Mac needed).
#
# Run on GitHub's macOS runner by .github/workflows/ios-ipa.yml. Raw `xcodebuild -exportArchive` could
# not create the iOS Distribution certificate on a fresh runner ("No signing certificate 'iOS
# Distribution' found"), so we use fastlane's proven CI signing recipe instead:
#   setup_ci                    → a temporary keychain for code signing on the ephemeral runner
#   cert(api_key:)              → create/download the DISTRIBUTION certificate into that keychain
#   sigh(api_key:)              → create the App Store provisioning profile for com.navbharat.ai
#   update_code_signing_settings→ switch the Capacitor project to MANUAL signing with that cert + profile
#   build_app                   → archive + export the signed .ipa
#   upload_to_testflight        → ship it to App Store Connect / TestFlight (when DO_UPLOAD=true)
# Everything authenticates with the App Store Connect API key (.p8) — the key must have the Admin role,
# which is what can create the distribution certificate.

default_platform(:ios)

APP_IDENTIFIER = "com.navbharat.ai"

platform :ios do
  desc "Build the App Store .ipa (cloud-signed) and optionally upload to TestFlight"
  lane :beta do
    setup_ci

    # duration: keep it WELL under Apple's 20-minute (1200s) cap. Using exactly 1200 makes Apple reject the
    # JWT with "Authentication credentials are missing or invalid" whenever there is any clock skew (the exp
    # claim lands at/over the 20-min limit). 500s is fastlane's own default and is comfortably valid.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("IOS_ASC_KEY_ID"),
      issuer_id: ENV.fetch("IOS_ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 500,
      in_house: false,
    )

    # A dedicated, UNLOCKED keychain with a KNOWN password. This is the fix for build #9's
    # `errSecInternalComponent` → "Could not find the newly generated certificate installed": `cert` must
    # import the new distribution certificate's private key AND run `security set-key-partition-list` so
    # codesign can use it non-interactively. That partition-list call needs the keychain password — without
    # it, the import fails on the headless runner. We create the keychain ourselves (default + in the search
    # list) and hand its password to both `cert` and `build_app`.
    keychain_name = "nbai_ci.keychain"
    keychain_password = "nbai_ci_ephemeral_pw"
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true,
    )

    # Distribution certificate. THE ROOT-CAUSE FIX (build 29504642757: "Could not create another
    # Distribution certificate, reached the maximum number of available Distribution certificates"):
    # `cert` MINTS A NEW distribution certificate on every run, because the private key never survives the
    # ephemeral runner. Apple caps distribution certs at 2 — so after two runs, every build fails here.
    #
    # DURABLE PATH (preferred): supply ONE persistent distribution certificate + its private key once, as a
    # base64-encoded `.p12` in the IOS_DIST_CERT_P12_BASE64 secret (password in IOS_DIST_CERT_PASSWORD).
    # We import THAT and reuse it every run — `cert` is never called, so the 2-cert cap is never touched
    # again. import_certificate also runs `security set-key-partition-list` (needs keychain_password) so
    # codesign can use the key non-interactively on the headless runner.
    #
    # FALLBACK (secret unset): today's behavior exactly — mint via the API. Keeps working until the cap.
    dist_p12_b64 = ENV["IOS_DIST_CERT_P12_BASE64"].to_s.strip
    if dist_p12_b64.empty?
      cert(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password,
      )
    else
      require "base64"
      p12_path = File.join(ENV.fetch("RUNNER_TEMP"), "nbai_dist.p12")
      File.open(p12_path, "wb") { |f| f.write(Base64.decode64(dist_p12_b64)) }
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["IOS_DIST_CERT_PASSWORD"].to_s,
        keychain_name: keychain_name,
        keychain_password: keychain_password,
      )
      File.delete(p12_path) if File.exist?(p12_path) # the private key now lives only in the ephemeral keychain
    end

    # Native "Sign in with Apple" (opt-in via APPLE_SIGNIN=true): the workflow injects the entitlement,
    # and for the profile `sigh` creates to INCLUDE that entitlement the capability must be enabled on the
    # App ID. That capability is enabled ONCE, by hand, in the Apple Developer portal (Identifiers →
    # com.navbharat.ai → "Sign In with Apple" ✅) — a single, reliable checkbox. We deliberately do NOT
    # automate it with `produce enable_services` here: `produce` does not accept an App Store Connect
    # `api_key` (it authenticates differently), so that call failed the build. With the capability enabled
    # on the App ID, `sigh force:true` below regenerates a profile that carries com.apple.developer.applesignin.

    # App Store provisioning profile for the bundle id (sigh defaults to an App Store distribution profile).
    # force:true so it REGENERATES the profile — a stale cached profile from before Sign in with Apple was
    # enabled would otherwise be reused and omit the new entitlement.
    # Same reasoning applies to push notifications (opt-in via ENABLE_PUSH=true, admin 2026-07-26): a
    # stale cached profile from before the Push Notifications capability was enabled on the App ID would
    # otherwise be reused and omit the aps-environment entitlement, so a push-enabled build also forces
    # regeneration.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: ENV["APPLE_SIGNIN"] == "true" || ENV["ENABLE_PUSH"] == "true",
    )

    # The Capacitor project ships with automatic signing; switch it to manual so the archive uses the
    # exact distribution cert + profile created above (no dependence on Xcode cloud cert creation).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV.fetch("IOS_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "Apple Distribution",
      targets: ["App"],
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ENV.fetch("RUNNER_TEMP"),
      output_name: "NavBharatAI",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME],
        },
      },
    )

    if ENV["DO_UPLOAD"] == "true"
      # WAIT for Apple to finish processing so a green run means the build is GENUINELY available in
      # TestFlight — not merely "uploaded". THE ROOT CAUSE of "build succeeded but no update shows in
      # TestFlight": skip_waiting:true (the old value) returned success the instant the binary was
      # accepted for transfer, BEFORE Apple processed it — so a build that later failed processing, or
      # never became available to testers, still showed a green run with nothing to diagnose. Waiting
      # turns that silent gap into an honest pass/fail (the upload itself is unchanged; only the
      # confirmation is added). Apple processing is usually a few minutes.
      changelog = ENV["IOS_CHANGELOG"].to_s.strip
      changelog = "Latest NavBharatAI build (##{ENV['GITHUB_RUN_NUMBER']})." if changelog.empty?

      opts = {
        api_key: api_key,
        ipa: File.join(ENV.fetch("RUNNER_TEMP"), "NavBharatAI.ipa"),
        skip_waiting_for_build_processing: false,
        changelog: changelog,
      }

      # Internal testers (App Store Connect users, incl. the account owner) receive every PROCESSED build
      # automatically — no group or review needed, which is why waiting-for-processing above is usually all
      # it takes for the update to appear. EXTERNAL testers are different: a build only reaches them once it
      # is assigned to an external group AND passes Beta App Review. Set IOS_TESTFLIGHT_GROUPS (a
      # comma-separated list of your TestFlight external group names) to have each build submitted +
      # notified to those testers automatically. Unset ⇒ internal-only (today's behavior).
      groups = ENV["IOS_TESTFLIGHT_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
      unless groups.empty?
        opts[:distribute_external] = true
        opts[:groups] = groups
        opts[:notify_external_testers] = true
      end

      upload_to_testflight(opts)
    end
  end
end
