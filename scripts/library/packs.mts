export interface Pack { owner: string; repo: string; revision: string; provider: 'kaykit' | 'kenney' | 'github'; spdx: 'CC0-1.0' | 'MIT'; author: string; attribution: string; licenseFile: string; root: string }
export const KAYKIT = (repo: string, revision: string, root: string): Pack => ({ owner: 'KayKit-Game-Assets', repo, revision, provider: 'kaykit', spdx: 'CC0-1.0', author: 'Kay Lousberg', attribution: 'KayKit by Kay Lousberg. CC0 1.0 Universal.', licenseFile: 'LICENSE.txt', root });
/** Kayque Rotondo's kits: every model is generated by Blender scripts kept in the same repository (authorship evidence). */
export const KAYQUER = (repo: string, revision: string, author: string, root = 'models'): Pack => ({ owner: 'kayquer', repo, revision, provider: 'github', spdx: 'CC0-1.0', author, attribution: `${author} (github.com/kayquer/${repo}). CC0 1.0 Universal.`, licenseFile: 'LICENSE', root });
export const KENNEY = (repo: string, revision: string, year: number, licenseFile: string): Pack => ({ owner: 'KenneyNL', repo, revision, provider: 'kenney', spdx: 'MIT', author: 'Kenney', attribution: `Copyright (c) ${year} Kenney`, licenseFile, root: 'models' });
